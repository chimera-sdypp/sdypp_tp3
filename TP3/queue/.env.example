# Credenciales de RabbitMQ para los ejemplos del Hit #0: copiar a .env (no se versiona) y cambiar la contraseña.
# RabbitMQ crea el usuario con RABBITMQ_DEFAULT_*; productores y consumidores se conectan con RABBITMQ_USER/PASS.
RABBITMQ_DEFAULT_USER=hit0
RABBITMQ_DEFAULT_PASS=cambiar
RABBITMQ_USER=hit0
RABBITMQ_PASS=cambiar
